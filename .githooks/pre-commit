#!/bin/sh
# 提交前跑全套测试。用法：
#   pre-commit staged  —— 无 .py 变更时跳过（pre-commit 用）
#   pre-commit all     —— 总是跑（pre-push 用）
# 紧急跳过：git commit --no-verify
set -u

mode="${1:-staged}"
py="${PYTHON:-python}"

if [ "$mode" = "staged" ]; then
    if ! git diff --cached --name-only --diff-filter=ACMR | grep -q '\.py$'; then
        exit 0
    fi
fi

if [ "${ALLOW_RED:-0}" = "1" ]; then
    echo "hooks: ALLOW_RED=1，跳过 pytest（失败快照；下一提交必须转绿）" >&2
    exit 0
fi

if ! command -v "$py" >/dev/null 2>&1; then
    echo "hooks: 找不到 '$py'；请设置 PYTHON=/path/to/python" >&2
    exit 1
fi

if ! "$py" -m pytest --version >/dev/null 2>&1; then
    echo "hooks: '$py' 里没有 pytest（.venv 可能是空壳）；请设置 PYTHON" >&2
    exit 1
fi

"$py" -m pytest -q || {
    echo "hooks: pytest 未通过，已中止（git commit --no-verify 可跳过）" >&2
    exit 1
}
